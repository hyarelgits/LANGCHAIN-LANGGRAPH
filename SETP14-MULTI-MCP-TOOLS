STEP 2: CREATE EMI TOOL
File: tools/emi_tool.py

def calculate_emi(principal, annual_rate, years):
    monthly_rate = annual_rate / 12 / 100
    months = years * 12
    emi = (principal * monthly_rate * ((1 + monthly_rate) ** months)) / (((1 + monthly_rate) ** months) - 1)
    return round(emi, 2)

