def route_question(question):
    q = question.lower()
    if 'emi' in q:
        return 'emi'
    if 'calculate' in q:
        return 'calculator'
    if 'cibil' in q or 'policy' in q:
        return 'policy'
    if 'customer' in q:
        return 'postgres'
    return 'search'

